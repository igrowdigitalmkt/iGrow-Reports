diff --git a/src/api/routes/chat.router.ts b/src/api/routes/chat.router.ts
index 158947e..27c62b4 100644
--- a/src/api/routes/chat.router.ts
+++ b/src/api/routes/chat.router.ts
@@ -193,0 +194,11 @@ export class ChatRouter extends RouterBroker {
+      // Private, API-key-protected lookup. Uses Baileys' signal identity map,
+      // never names, profile pictures, or guessed number suffixes.
+      .post(this.routerPath('resolvePeerLinks'), ...guards, async (req, res) => {
+        const instance = req.params as unknown as InstanceDto;
+        const lids = (req.body as { lids?: unknown } | null)?.lids;
+        if (!Array.isArray(lids) || lids.length > 60 || !lids.every(lid => typeof lid === 'string' && /^[0-9]{8,20}@lid$/.test(lid))) {
+          return res.status(HttpStatus.BAD_REQUEST).json({ error: 'Invalid peer identifiers' });
+        }
+        const result = await chatController.resolvePeerLinks(instance, [...new Set(lids)]);
+        return res.status(HttpStatus.OK).json(result);
+      })

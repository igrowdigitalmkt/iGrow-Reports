+  // The WhatsApp signal repository is authoritative for phone↔LID links.
+  // Profile pictures, titles and timestamps are NOT valid identity evidence.
+  private async mappedPhoneJid(jid: string | undefined): Promise<string | undefined> {
+    if (!jid?.endsWith('@lid')) return undefined;
+    try {
+      const phone = await this.client.signalRepository.lidMapping.getPNForLID(jid);
+      return typeof phone === 'string' && /^[0-9]{8,15}@s[.]whatsapp[.]net$/.test(phone) ? phone : undefined;
+    } catch {
+      return undefined;
+    }
+  }
+
+  public async resolvePeerLinks(lids: string[]): Promise<{ lid: string; phone: string }[]> {
+    const links: { lid: string; phone: string }[] = [];
+    for (let i = 0; i < lids.length; i += 20) {
+      const chunk = await Promise.all(lids.slice(i, i + 20).map(async (lid) => ({
+        lid, phone: await this.mappedPhoneJid(lid),
+      })));
+      for (const pair of chunk) if (pair.phone) links.push({ lid: pair.lid, phone: pair.phone });
+    }
+    return links;
+  }
+

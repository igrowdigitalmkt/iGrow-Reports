+  public async resyncIgrowChatState() {
+    const collections = ['critical_unblock_low', 'regular_high', 'regular_low', 'critical_block', 'regular'] as const;
+
+    // One-shot repair for iGrow. Our tiny Baileys patch makes resyncAppState return the decoded
+    // mutation map; Evolution can then forward archive/read state directly instead of depending
+    // on Baileys' event buffer, which intentionally suppresses some historical chat updates.
+    await this.instance.authState.state.keys.set({
+      'app-state-sync-version': Object.fromEntries(collections.map((name) => [name, null])),
+    });
+    const mutations = (await this.client.resyncAppState(collections, false)) as unknown as Record<string, any>;
+    const states = new Map<string, { remoteJid: string; instanceId: string; archived?: boolean; unreadMessages?: number }>();
+
+    for (const mutation of Object.values(mutations ?? {})) {
+      const action = mutation?.syncAction?.value;
+      const index = mutation?.index;
+      const type = Array.isArray(index) ? index[0] : undefined;
+      const remoteJid = Array.isArray(index) && typeof index[1] === 'string' ? index[1] : null;
+      if (!remoteJid) continue;
+
+      const current = states.get(remoteJid) ?? { remoteJid, instanceId: this.instanceId };
+      if (action?.archiveChatAction || type === 'archive' || type === 'unarchive') {
+        current.archived = action?.archiveChatAction ? !!action.archiveChatAction.archived : type === 'archive';
+      }
+      if (action?.markChatAsReadAction?.read === true) {
+        current.unreadMessages = 0;
+      }
+      states.set(remoteJid, current);
+    }
+
+    const payload = [...states.values()].filter((state) => state.archived !== undefined || state.unreadMessages !== undefined);
+    if (payload.length) this.sendDataWebhook(Events.CHATS_UPDATE, payload);
+
+    // App-state may contain no historical chat mutations on an already-linked companion. In that
+    // case ask the primary phone for a controlled full-history sync. Its messaging-history.set event
+    // is already bridged as CHATS_SET, including archived/unread fields by the iGrow patch.
+    let historyRequested = false;
+    if (payload.length === 0) {
+      const fetchFullHistory = (this.client as any).fetchFullHistory;
+      if (typeof fetchFullHistory === 'function') {
+        await fetchFullHistory.call(this.client);
+        historyRequested = true;
+      }
+    }
+
+    return {
+      synced: true,
+      chats: payload.length,
+      archived: payload.filter((state) => state.archived === true).length,
+      read: payload.filter((state) => state.unreadMessages === 0).length,
+      historyRequested,
+    };

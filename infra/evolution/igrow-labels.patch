+        await this.client.authState.keys.set({ 'app-state-sync-version': { regular: null, regular_low: null } });
+        await this.client.resyncAppState(['regular', 'regular_low'], true);
+        const synced = await this.client.authState.keys.get('app-state-sync-version', ['regular', 'regular_low']);
+        if (!Number.isInteger(synced.regular?.version) || !Number.isInteger(synced.regular_low?.version))
+          throw new BadRequestException('IGROW_LABEL_STATE_UNAVAILABLE');
+        await this.eventProcessingQueue;
+        this.igrowLabelsReady = true;
+      })().finally(() => { this.igrowLabelsInitialization = undefined; });

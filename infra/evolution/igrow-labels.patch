+    const blocked = (await this.client.fetchBlocklist()).some((jid) => jidNormalizedUser(jid) === peer);
+    if (data.blocked !== undefined && blocked !== data.blocked)
+      throw new BadRequestException('WhatsApp did not confirm the block status');
+    return { blocked };
+  }

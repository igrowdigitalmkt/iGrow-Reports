# Aplicação. Configure cada ambiente separadamente; nunca use produção no desenvolvimento.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REPORTS_URL=http://localhost:3000
APP_ENV=local

# Necessários para autenticação e banco. Copie do painel do seu projeto Supabase.
# Somente chave publishable (sb_publishable_...) ou JWT anon legado. Nunca service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A demonstração usa apenas fixtures em /demo; não efetua chamadas ou envios reais.
# Sem esta variável: habilitada em desenvolvimento/testes, desabilitada em produção.
ENABLE_DEMO=true

# Integrações e operações privilegiadas do servidor.
# Mantenha segredos apenas no servidor. Não prefixar com NEXT_PUBLIC_.
# Prefira a nova Secret key (sb_secret_...). O nome legado abaixo é fallback temporário.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
META_GRAPH_API_VERSION=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Token aleatório de 32 a 256 caracteres (letras, dígitos, _ ou -), somente servidor.
# Autoriza POST /api/workers/meta; configurar não cria agendamento.
INTEGRATION_WORKER_SECRET=
# "true" desativa o processamento da fila logo após uma solicitação de coleta (padrão: ativo).
INLINE_COLLECTION_DISABLED=
QSTASH_TOKEN=
# Origem oficial do QStash da conta; vazio usa https://qstash.upstash.io.
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=
SENTRY_DSN=
EXTERNAL_DELIVERIES_ENABLED=false
